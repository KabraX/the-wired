                --data-urlencode "_token=$token")

            num_episodios=$(echo "$json_response" | grep -oP '"total":\s*\K\d+')
        fi
    fi

    [ -f cookies.txt ] && rm cookies.txt

    clear
    echo -e "Anime: $GREEN $titulo_elegido $WHITE"

    last_cap=$(get_last_cap "$titulo_elegido")

    if [ -d "$url_without_https" ]; then
        tipo=$(grep -oP '<span>Tipo:</span> \K[^<]+' "$url_without_https/index.html" | tail -n 1)
    else
        tipo=$(grep -oP '<span>Tipo:</span> \K[^<]+' "$url_without_https" | tail -n 1)
    fi

    echo -e "Ultimo episodio visto: $last_cap"


    if [ -z "$num_episodios" ]; then
        num_episodios=0
    fi

    if [ -z "$num_episodios" ]; then
        echo -e "Enlace ${CYAN}$nuevaurl${NC} no válido. Por favor ve a ${GREEN} https://github.com/KabraX/the-wired ${NC} y abre un issue especificando el enlace y el anime que estabas intentando ver. Lo corregiré y actualizaré el script ;)"
        echo "$url_without_https"
        exit
    fi

    if [ "$CONTINUE" == 1 ]; then
        capi=$last_cap
        progress=$(get_progress "$titulo_elegido")

    else
        capi=$(seq 1 "$num_episodios" | fzf \
            --prompt="Episodio: " \
            --height=~30 \
            --border \
            --reverse)
    fi

    clear

    if [ "$tipo" == "Pelicula" ]; then
        capi="pelicula"
    fi

    capurl="$nuevaurl/$capi"

    # ----------------------------------------------------------------------------
    # scrape_episode: extrae UNICAMENTE el scraping del episodio.
    # No reproduce ni muestra menus. Rellena la variable global src_contenido
    # con la URL fresca del stream (.m3u8 o directo).
    #
    # $1 = URL completa del episodio
    #
    # Métodos soportados:
    #   1. jkplayer (actual)
    #   2. jk.php (legacy)
    #   3. Mediafire (legacy)
    # ----------------------------------------------------------------------------
    scrape_episode() {
        local capa="$1"
        local tmp_dir
        local main_html
        local jkplayer_html
        local jkplayer_path
        local jkplayer_url
        local jkphp_path
        local jkphp_url
        local jkphp_html
        local servers_file
        local mediafire_url
        local mediafire_html
        local domain
        local ua
        local wget_rc

        src_contenido=""

        ua="$USER_AGENT"

        echo -e "${CYAN}[Scraper] Episodio: $capa${NC}"
        echo -e "${CYAN}[Scraper] Descargando página...${NC}"

        tmp_dir=$(mktemp -d)
        main_html="$tmp_dir/main.html"

        # ------------------------------------------------------------------------
        # 1. Página principal del episodio
        # ------------------------------------------------------------------------

        wget \
            --user-agent="$ua" \
            -O "$main_html" \
            "$capa" \
            >/dev/null \
            2>"$tmp_dir/wget_main.log"

        wget_rc=$?

        if [[ $wget_rc -ne 0 || ! -s "$main_html" ]]; then
            echo -e "${RED}[Scraper] No se pudo descargar la página principal.${NC}"

            if [[ -s "$tmp_dir/wget_main.log" ]]; then
                echo -e "${RED}[Scraper] wget:${NC}"
                sed 's/^/  /' "$tmp_dir/wget_main.log"
            fi

            rm -rf "$tmp_dir"
            return 1
        fi

        echo -e "${GREEN}[Scraper] Página principal descargada.${NC}"

        domain=$(grep -oP '^https?://[^/]+' <<<"$capa")

        # =========================================================================
        # 2. JKPLAYER — método actual
        # =========================================================================

        echo -e "${CYAN}[Scraper] Buscando reproductor jkplayer...${NC}"

        jkplayer_path=$(grep -oP '(?<=jkplayer/)um[^"'"'"'<> ]*' "$main_html" | head -n 1)

        if [[ -n "$jkplayer_path" ]]; then

            echo -e "${GREEN}[Scraper] Referencia jkplayer encontrada.${NC}"

            jkplayer_url="${domain}/jkplayer/${jkplayer_path}"
            jkplayer_html="$tmp_dir/jkplayer.html"

            echo -e "${CYAN}[Scraper] Descargando recurso jkplayer...${NC}"

            wget \
                --user-agent="$ua" \
                -O "$jkplayer_html" \
                "$jkplayer_url" \
                >/dev/null \
                2>"$tmp_dir/wget_jkplayer.log"

            if [[ -s "$jkplayer_html" ]]; then

                # Soporta:
                #   url: 'https://...'
                #   url: atob('...')
                src_contenido=$(grep -A 3 "video: {" "$jkplayer_html" | sed -n \
                    -e "s/.*url: '\(http[^']*\)'.*/\1/p" \
                    -e "s/.*url: atob('\([^']*\)').*/\1/p" \
                    -e "s/.*url: '\([^']*\)',.*/\1/p" \
                    | head -n 1)

                # Si lo extraído parece Base64, decodificarlo.
                if [[ -n "$src_contenido" && "$src_contenido" != http* ]]; then
                    local decoded_url
                    decoded_url=$(base64 -d <<<"$src_contenido" 2>/dev/null)

                    if [[ "$decoded_url" == http* ]]; then
                        src_contenido="$decoded_url"
                    fi
                fi

                if [[ -n "$src_contenido" ]]; then
                    echo -e "${GREEN}[Scraper] URL encontrada mediante jkplayer.${NC}"
                    rm -rf "$tmp_dir"
                    return 0
                fi

                echo -e "${YELLOW}[Scraper] jkplayer fue encontrado, pero no se pudo extraer la URL.${NC}"

            else
                echo -e "${YELLOW}[Scraper] No se pudo descargar el recurso jkplayer.${NC}"
            fi

        else
            echo -e "${YELLOW}[Scraper] No se encontró referencia a jkplayer.${NC}"
        fi

        # =========================================================================
        # 3. JK.PHP — método legacy
        # =========================================================================

        echo -e "${CYAN}[Scraper] Probando reproductor jk.php legacy...${NC}"

        # Extrae el parámetro/query después de /jk.php
        jkphp_path=$(grep -oP '<iframe[^>]+src="/jk\.php\K[^"]*' "$main_html" | head -n 1)

        if [[ -n "$jkphp_path" ]]; then

            echo -e "${GREEN}[Scraper] Referencia jk.php encontrada.${NC}"

            jkphp_url="${domain}/jk.php${jkphp_path}"
            jkphp_html="$tmp_dir/jk.php.html"

            echo -e "${CYAN}[Scraper] Descargando recurso jk.php...${NC}"

            wget \
                --user-agent="$ua" \
                -O "$jkphp_html" \
                "$jkphp_url" \
                >/dev/null \
                2>"$tmp_dir/wget_jkphp.log"

            if [[ -s "$jkphp_html" ]]; then

                src_contenido=$(grep -A 3 "video: {" "$jkphp_html" | sed -n \
                    -e "s/.*url: '\(http[^']*\)'.*/\1/p" \
                    -e "s/.*url: atob('\([^']*\)').*/\1/p" \
                    -e "s/.*url: '\([^']*\)',.*/\1/p" \
                    | head -n 1)

                if [[ -n "$src_contenido" && "$src_contenido" != http* ]]; then
                    local decoded_url
                    decoded_url=$(base64 -d <<<"$src_contenido" 2>/dev/null)

                    if [[ "$decoded_url" == http* ]]; then
                        src_contenido="$decoded_url"
                    fi
                fi

                if [[ -n "$src_contenido" ]]; then
                    echo -e "${GREEN}[Scraper] URL encontrada mediante jk.php.${NC}"
                    rm -rf "$tmp_dir"
                    return 0
                fi

                echo -e "${YELLOW}[Scraper] jk.php fue encontrado, pero no se pudo extraer la URL.${NC}"

            else
                echo -e "${YELLOW}[Scraper] No se pudo descargar el recurso jk.php.${NC}"
            fi

        else
            echo -e "${YELLOW}[Scraper] No se encontró referencia a jk.php.${NC}"
        fi

        # =========================================================================
        # 4. MEDIAFIRE — método legacy
        # =========================================================================

        echo -e "${CYAN}[Scraper] Buscando servidor Mediafire...${NC}"

        servers_file="$tmp_dir/servers.txt"

        # Extraemos "var servers = [...];" directamente desde el HTML.
        # Se usa Python para soportar el caso donde el array ocupa varias líneas.
        python3 - "$main_html" >"$servers_file" <<'PY'
import re
import sys

path = sys.argv[1]

with open(path, "r", encoding="utf-8", errors="ignore") as f:
    html = f.read()

match = re.search(
    r'var\s+servers\s*=\s*(\[.*?\]);',
    html,
    re.DOTALL
)

if match:
    print(match.group(1))
PY

        if [[ ! -s "$servers_file" ]]; then
            echo -e "${YELLOW}[Scraper] No se encontró la variable servers.${NC}"
            rm -rf "$tmp_dir"
            return 1
        fi

        mediafire_url=$(
            python3 - "$servers_file" <<'PY'
import json
import base64
import sys

path = sys.argv[1]

with open(path, "r", encoding="utf-8", errors="ignore") as f:
    servers = json.load(f)

for server in servers:
    if str(server.get("server", "")).lower() == "mediafire":
        remote = server.get("remote")

        if remote:
            try:
                print(base64.b64decode(remote).decode("utf-8"))
            except Exception:
                pass

        break
PY
        )

        if [[ -z "$mediafire_url" ]]; then
            echo -e "${YELLOW}[Scraper] No se encontró servidor Mediafire válido.${NC}"
            rm -rf "$tmp_dir"
            return 1
        fi

        echo -e "${GREEN}[Scraper] URL de Mediafire encontrada.${NC}"

        mediafire_html="$tmp_dir/mediafire.html"

        echo -e "${CYAN}[Scraper] Descargando página de Mediafire...${NC}"

        wget \
            --user-agent="$ua" \
            --max-redirect=20 \
            -O "$mediafire_html" \
            "$mediafire_url" \
            >/dev/null \
            2>"$tmp_dir/wget_mediafire.log"

        if [[ ! -s "$mediafire_html" ]]; then
            echo -e "${RED}[Scraper] No se pudo descargar la página de Mediafire.${NC}"
            rm -rf "$tmp_dir"
            return 1
        fi

        # Mediafire normalmente contiene el enlace real de descarga
        # en un href que comienza por https://download...
        src_contenido=$(grep -oP 'href="\Khttps://download[^"]+' "$mediafire_html" | head -n 1)

        if [[ -z "$src_contenido" ]]; then
            # Fallback para HTML donde el href no utiliza exactamente esa forma.
            src_contenido=$(grep -oP 'https://download[^"'\'' ]+' "$mediafire_html" | head -n 1)
        fi

        if [[ -n "$src_contenido" ]]; then
            echo -e "${GREEN}[Scraper] URL encontrada mediante Mediafire.${NC}"
            rm -rf "$tmp_dir"
            return 0
        fi

        echo -e "${RED}[Scraper] Mediafire fue encontrado, pero no se pudo extraer la URL de descarga.${NC}"

        src_contenido=""

        rm -rf "$tmp_dir"
        return 1
    }

    # ----------------------------------------------------------------------------
    # videocap: scraping + reproduccion con mpv + menu Siguiente/Retroceder/Atras.
    # Mantiene el comportamiento original. Solo se ha extraido el scraping a
    # scrape_episode() para poder reutilizarlo en las descargas.
    # ----------------------------------------------------------------------------
    videocap() {
        capa=$1

        scrape_episode "$capa"

        if [ "$tipo" == "Pelicula" ]; then
            capi=1
        fi

        clear

        echo "Capitulo: $capi"

        rm -r jkanime.net mediafire.com >/dev/null 2>&1

        ENV=$(detect_env)
        pos=0

        case "$ENV" in
            wsl)
                if command -v mpv.exe >/dev/null 2>&1; then
                    pos=$(mpv.exe --start="$progress" --msg-level=ffmpeg=no --force-media-title="$opcion-$capi" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
                else
                    echo "mpv.exe no encontrado en Windows PATH"
                fi
                ;;
            termux)
                if pm list packages | grep -q 'org.videolan.vlc'; then
                    am start -a android.intent.action.VIEW -d "$src_contenido" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity
                    pos=0
                else
                    termux-open-url "$src_contenido"
                    pos=0
                fi
                ;;
            linux)
                if command -v mpv >/dev/null 2>&1; then
                    pos=$(mpv --start="$progress" -v --msg-level=ffmpeg=no --force-media-title="$opcion-$capi" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1 | sed 's/AV: //g' 2>&1)
                fi
                ;;
        esac

        save_history "$titulo_elegido" "$capi" "$pos"

        op=$( (
            echo "Siguiente"
            echo "Retroceder"
            echo "Atras"
        ) | tac | fzf --prompt="Selecciona una opción: " --height=7 --border --info=inline --margin=1,1,0,0)

        if [[ "$op" == "Siguiente" ]]; then
            progress="00:00:00"
            capi=$((capi + 1))
            save_history "$titulo_elegido" "$capi" "$pos"
            videocap "$nuevaurl/$capi"
        elif [[ "$op" == "Retroceder" ]]; then
            progress="00:00:00"
            capi=$((capi - 1))
            videocap "$nuevaurl/$capi"
        elif [[ "$opcion" == "Atras" ]]; then

            main
        fi
    }

    # ----------------------------------------------------------------------------
    # download_season: descarga todos los episodios de una temporada.
    # IMPORTANTE: las URLs .m3u8 son temporales, por eso se obtiene una URL FRESCA
    # para cada episodio justo antes de descargarlo (scrape_episode por episodio).
    # $1 = nombre del anime
    # $2 = episodio inicial
    # $3 = episodio final (num_episodios)
    # $4 = URL base del anime (nuevaurl)
    # ----------------------------------------------------------------------------
    download_season() {
        local anime="$1"
        local start_ep="$2"
        local end_ep="$3"
        local base_url="$4"
        local ep downloaded=0 existing=0 failed=0 failed_eps="" rc

        for ep in $(seq "$start_ep" "$end_ep"); do
            echo ""
            echo -e "${CYAN}=== Episodio $ep ===${NC}"

            # Comprobacion temprana: si ya existe y es valido y completo, ni siquiera scrapeamos.
            local out_path part_files
            out_path=$(get_episode_output_path "$anime" 1 "$ep")
            part_files=$(ls "${out_path%.mp4}".mp4.part* 2>/dev/null)
            if [[ -f "$out_path" ]] && ffprobe -v error "$out_path" >/dev/null 2>&1 && [[ -z "$part_files" ]]; then
                echo -e "${YELLOW}Episodio $ep ya existe. Omitiendo...${NC}"
                existing=$((existing + 1))
                continue
            fi

            # URL fresca por episodio
            echo "Obteniendo URL del episodio $ep..."
            capi="$ep"
            scrape_episode "$base_url/$ep"

            # Limpieza de los temporales del wget
            rm -r jkanime.net mediafire.com >/dev/null 2>&1

            if [[ -z "$src_contenido" ]]; then
                echo -e "${RED}No se pudo obtener la URL del episodio $ep.${NC}"
                aviso_sitio_cambiado
                failed=$((failed + 1))
                failed_eps="${failed_eps}- $(printf "%02d" "$ep")\n"
                continue
            fi

            download_episode "$anime" "$ep" "$src_contenido"
            rc=$?
            if [[ $rc -ne 0 ]]; then
                failed=$((failed + 1))
                failed_eps="${failed_eps}- $(printf "%02d" "$ep")\n"
            else
                # Distinguir si era ya existente (download_episode devuelve 0 tambien al omitir)
                if [[ -f "$out_path" ]] && ffprobe -v error "$out_path" >/dev/null 2>&1; then
                    # Si tras la llamada sigue siendo el mismo archivo preexistente lo
                    # contamos como existing; download_episode ya lo habra anunciado.
                    :
                fi
                downloaded=$((downloaded + 1))
            fi
        done

        echo ""
        echo "===================================="
        echo "      DESCARGA COMPLETADA"
        echo "===================================="
        echo ""
        echo "Anime: $anime"
        echo "Temporada: 1"
        echo ""
        echo "Descargados: $downloaded"
        echo "Ya existentes: $existing"
        echo "Fallidos: $failed"
        echo "Total: $((downloaded + existing + failed))"

        if [[ $failed -gt 0 ]]; then
            echo ""
            echo "Episodios con error:"
            printf "%b" "$failed_eps"
        fi
    }

    # ----------------------------------------------------------------------------
    # Menu de accion tras seleccionar episodio.
    # En modo descarga (-d) se oculta "Reproducir".
    # ----------------------------------------------------------------------------
    if [[ "$DOWNLOAD_MODE" == 1 ]]; then
        opciones_accion=("Descargar episodio" "Descargar temporada" "Atrás")
    else
        opciones_accion=("Reproducir" "Descargar episodio" "Descargar temporada" "Atrás")
    fi

    accion=$(printf "%s\n" "${opciones_accion[@]}" | tac | fzf --prompt="Acción: " --height=~12 --border --info=inline --margin=1,1,0,0)
    clear

    case "$accion" in
        "Reproducir")
            videocap "$capurl"
            ;;

        "Descargar episodio")
            if ! check_download_deps; then
                read -rp "Pulsa Enter para volver al menú..."
                main
            fi

            # Numero de episodio real para el nombre de archivo
            if [ "$tipo" == "Pelicula" ]; then
                ep_num=1
            else
                ep_num="$capi"
            fi

            echo "Obteniendo URL del episodio..."
            scrape_episode "$capurl"
            rm -r jkanime.net mediafire.com >/dev/null 2>&1

            if [[ -z "$src_contenido" ]]; then
                echo -e "${RED}No se pudo obtener la URL del video.${NC}"
                aviso_sitio_cambiado
                read -rp "Pulsa Enter para continuar..."
                main
            fi

            echo -e "${CYAN}URL obtenida:${NC} $src_contenido"
            echo ""
            download_episode "$titulo_elegido" "$ep_num" "$src_contenido"
            echo ""
            read -rp "Pulsa Enter para continuar..."
            main
            ;;

        "Descargar temporada")
            if ! check_download_deps; then
                read -rp "Pulsa Enter para volver al menú..."
                main
            fi

            # Para peliculas no tiene sentido "temporada": se descarga el unico ep.
            if [ "$tipo" == "Pelicula" ]; then
                echo "Obteniendo URL del episodio..."
                scrape_episode "$capurl"
                rm -r jkanime.net mediafire.com >/dev/null 2>&1
                if [[ -n "$src_contenido" ]]; then
                    download_episode "$titulo_elegido" 1 "$src_contenido"
                else
                    echo -e "${RED}No se pudo obtener la URL del video.${NC}"
                    aviso_sitio_cambiado
                fi
                read -rp "Pulsa Enter para continuar..."
                main
            fi

            download_season "$titulo_elegido" 1 "$num_episodios" "$nuevaurl"
            echo ""
            read -rp "Pulsa Enter para continuar..."
            main
            ;;

        "Atrás" | "Atras")
            main
            ;;

        *)
            main
            ;;
    esac
}

# Todo lo que el scraper descarga (paginas, cookies, listas) va a una carpeta
# temporal que se borra al salir, en vez de ensuciar la carpeta actual.
WORKDIR=$(mktemp -d "${TMPDIR:-/tmp}/the-wired.XXXXXX") || exit 1
trap 'rm -rf "$WORKDIR"' EXIT
# Ctrl+C o kill: salir por la via normal para que se ejecute la limpieza
trap 'exit 130' INT
trap 'exit 143' TERM
cd "$WORKDIR" || exit 1

check_update
main
