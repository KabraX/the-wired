    videos_dir=$(xdg-user-dir VIDEOS 2>/dev/null)
    [[ -z "$videos_dir" || "$videos_dir" == "$HOME" ]] && videos_dir="$HOME/Videos"
    ANIME_DOWNLOAD_DIR="$videos_dir/Anime"
fi
