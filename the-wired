LEGACY_HISTORY_FILE="$HOME/ani-es/history.json"

init_history() {

    mkdir -p "$HISTORY_DIR"

    # Migracion: si existe historial de ani-es y el de the-wired esta vacio/missing, copiarlo
    if [[ -f "$LEGACY_HISTORY_FILE" ]] && [[ ! -f "$HISTORY_FILE" || "$HISTORY_FILE" -ot "$LEGACY_HISTORY_FILE" ]]; then
        cp "$LEGACY_HISTORY_FILE" "$HISTORY_FILE"
        echo "Historial de ani-es migrado a the-wired."
    fi

    [[ -f "$HISTORY_FILE" ]] || echo "{}" >"$HISTORY_FILE"

    if [[ -f "$OLD_DB" ]]; then

        echo
        echo "El sistema de guardado de historial ha cambiado."
        read -rp "¿Desea importar su antiguo historial? (y/n): " respuesta

        if [[ "$respuesta" =~ ^[YySs]$ ]]; then

            echo "Importando historial..."

            if python3 <<EOF
import sqlite3
import json

db_path = "$OLD_DB"
json_path = "$HISTORY_FILE"

try:
    with open(json_path, "r", encoding="utf-8") as f:
        history = json.load(f)
except:
    history = {}

conn = sqlite3.connect(db_path)
cursor = conn.cursor()

cursor.execute("""
SELECT name
FROM sqlite_master
WHERE type='table' AND name='animes'
""")

if cursor.fetchone():

    cursor.execute("SELECT anime,last_cap,progress FROM animes")

    for anime,last_cap,progress in cursor.fetchall():

        try:
            last_cap = int(last_cap)
        except (TypeError, ValueError):
            last_cap = 0

        if not progress:
            progress = "00:00:00"

        history[anime] = {
            "last_cap": last_cap,
            "progress": progress
        }

conn.close()

with open(json_path, "w", encoding="utf-8") as f:
    json.dump(history, f, indent=4, ensure_ascii=False)

EOF
            then
                rm -f "$OLD_DB"
                echo "Historial importado correctamente."
            else
                echo "Ha ocurrido un error durante la importación."
                echo "La base de datos antigua no se ha eliminado."
            fi

        else
            rm -f "$OLD_DB"
            echo "El historial antiguo ha sido eliminado."
        fi
    fi
}

init_history

clear
get_last_cap() {
    jq -r --arg anime "$1" \
        '.[$anime].last_cap // ""' \
        "$HISTORY_FILE"
}

get_progress() {
    jq -r --arg anime "$1" \
        '.[$anime].progress // "00:00:00"' \
        "$HISTORY_FILE"
}

save_history() {
    local anime="$1"
    local cap="$2"
    local progress="$3"

    tmp=$(mktemp)

    jq \
        --arg anime "$anime" \
        --arg cap "$cap" \
        --arg progress "$progress" \
        '.[$anime] = {
            last_cap: ($cap|tonumber),
            progress: $progress
        }' \
        "$HISTORY_FILE" >"$tmp"

    mv "$tmp" "$HISTORY_FILE"
}

show_help() {
    echo ""
    echo "    Uso: the-wired [opciones] [busqueda]"
    echo ""
    echo "    Opciones:"
    echo "      -h, --help       Mostrar ayuda"
    echo "      -v, --version    Mostrar versión"
    echo "      -c, --continue   Continua el anime en donde ultimo lo dejaste"
    echo "      -d, --download   Modo descarga (oculta la opcion de reproducir)"
    echo "      -u, --update     Buscar actualizaciones ahora (ignora el limite de una vez al dia)"
    echo ""
    echo "    Variables: THE_WIRED_NO_UPDATE=1 desactiva la busqueda automatica de actualizaciones"
