[[ "$ANIME_DOWNLOAD_DIR" == /* || "$ANIME_DOWNLOAD_DIR" =~ ^[A-Za-z]: ]] || ANIME_DOWNLOAD_DIR="$PWD/$ANIME_DOWNLOAD_DIR"

