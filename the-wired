# Mensaje unico para cuando el scraper no encuentra lo que espera en la web
aviso_sitio_cambiado() {
    echo -e "${YELLOW}Si esto se repite con animes que sabes que existen, es probable que jkanime.net"
    echo -e "haya cambiado su web y the-wired necesite una actualizacion:${NC}"
    echo -e "  ${CYAN}the-wired -u${NC}   o revisa https://github.com/KabraX/the-wired/issues"
}

show_version() {
    echo -e "the-wired ${PURPLE}v${VERSION}${NC}"
}

# parseo de argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h | --help)
            show_help
            exit 0
            ;;
        -v | --version)
            show_version
            exit 0
            ;;
        -c | --continue)
            CONTINUE=1
            ;;
        -d | --download)
            DOWNLOAD_MODE=1
            ;;
        -u | --update)
            FORCE_UPDATE_CHECK=1
            ;;
        *)
            break
            ;;
    esac
    shift
done

arg1="$*"

check_dependencies() {
    local script_name
    script_name=$(basename "$0")
    local missing=()

    for cmd in "$@"; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${CYAN}[$script_name]${RED} Dependencias faltantes:${NC}"
        for pkg in "${missing[@]}"; do
            echo -e "${CYAN}  - $pkg ${NC}"
        done
        echo -e "${GREEN}Ejecuta el instalador antes de usar este script.${NC}"
        exit 1
    fi
}

detect_env() {
    # WSL (1 o 2)
    if grep -qi microsoft /proc/version 2>/dev/null || [ -n "$WSL_DISTRO_NAME" ]; then
        echo "wsl"
    # Termux (Android)
    elif [ -n "$PREFIX" ] && [[ "$PREFIX" == *com.termux* ]]; then
        echo "termux"
    # Linux normal
    else
        echo "linux"
    fi
}

# ============================================================================
# Funciones de descarga para Jellyfin
# ============================================================================

# Sanitiza un nombre para que sea valido como nombre de archivo en Windows.
# Elimina los caracteres invalidos: < > : " / \ | ? *
# No modifica otros caracteres Unicode (incluidos espacios y acentos).
# Usa octales en tr porque el backslash literal en argumentos se manglea en MSYS2.
#   < \074  > \076  : \072  " \042  / \057  \ \134  | \174  ? \077  * \052
sanitize_filename() {
    local name="$1"
    name=$(printf "%s" "$name" | tr -d "\074\076\072\042\057\134\174\077\052")
    # Recorta espacios/puntos al final (invalidos como sufijo en Windows)
    name="${name%"${name##*[![:space:].]}"}"
    printf "%s" "$name"
}

# Construye la ruta de salida Jellyfin para un episodio:
#   <ANIME_DOWNLOAD_DIR>/<Anime>/Season 01/<Anime> - S01E01.mp4
# $1 = nombre del anime
# $2 = numero de temporada (entero)
# $3 = numero de episodio (entero)
get_episode_output_path() {
    local anime="$1"
    local season="$2"
    local episode="$3"
    local safe_anime season_dir ep_num season_num filename

    safe_anime=$(sanitize_filename "$anime")
    season_dir=$(printf "Season %02d" "$season")
    ep_num=$(printf "%02d" "$episode")
    season_num=$(printf "%02d" "$season")
    filename="${safe_anime} - S${season_num}E${ep_num}.mp4"

    echo "${ANIME_DOWNLOAD_DIR}/${safe_anime}/${season_dir}/${filename}"
}

# Comprueba que las dependencias de descarga (yt-dlp y ffmpeg) estan presentes.
# Devuelve 0 si todo OK, 1 si falta alguna.
check_download_deps() {
    local missing=()
    local cmd
    for cmd in yt-dlp ffmpeg; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done
    if [ ${#missing[@]} -ne 0 ]; then
        for cmd in "${missing[@]}"; do
            echo -e "${RED}${cmd} no está instalado.${NC}"
        done
        echo -e "${YELLOW}Instala las dependencias antes de descargar.${NC}"
        return 1
    fi
    return 0
}

# Descarga un unico episodio con yt-dlp.
# $1 = nombre del anime
# $2 = numero de episodio (entero)
# $3 = URL del stream (.m3u8 o directo)
# Devuelve 0 si OK o si ya existia, codigo de yt-dlp si falla.
download_episode() {
    local anime="$1"
    local episode="$2"
    local url="$3"
    local out_path out_dir rc

    out_path=$(get_episode_output_path "$anime" 1 "$episode")
    out_dir=$(dirname "$out_path")

    # Si el archivo ya existe, comprobamos si es un MP4 valido con ffprobe
    # Y que no queden fragmentos parciales (.part*) sueltos.
    # Si es valido y completo -> omitimos. Si esta corrupto/incompleto -> redescargamos.
    if [[ -f "$out_path" ]]; then
        local part_files
        part_files=$(ls "${out_path%.mp4}".mp4.part* 2>/dev/null)
        if ffprobe -v error "$out_path" >/dev/null 2>&1 && [[ -z "$part_files" ]]; then
            echo -e "${YELLOW}Episodio $episode ya existe. Omitiendo...${NC}"
            return 0
        else
            # Archivo parcial/corrupto: razon clara para eliminarlo.
            echo -e "${YELLOW}Episodio $episode existe pero está incompleto. Redescargando...${NC}"
            rm -f "$out_path" "${out_path%.mp4}".mp4.part* 2>/dev/null
        fi
    fi

    mkdir -p "$out_dir"

    echo -e "${CYAN}Descargando episodio $episode a:${NC}"
    echo "  $out_path"

    # --merge-output-format mp4 : remuxea a MP4 compatible Jellyfin sin recodificar
    #   (H.264 + AAC se remuxea, no se reencodea).
    # -o ...%(ext)s : yt-dlp elige la extension y al fusionar queda .mp4.
    # Comportamiento por defecto de yt-dlp: continua descargas parciales (.part).
    yt-dlp --merge-output-format mp4 -o "${out_path%.mp4}.%(ext)s" "$url"
    rc=$?

    if [[ $rc -ne 0 ]]; then
        echo -e "${RED}Error descargando episodio $episode (código $rc).${NC}"
        return $rc
    fi

    echo -e "${GREEN}Episodio $episode descargado correctamente.${NC}"
    return 0
}

# --- Actualizaciones -------------------------------------------------------
# Compara el VERSION remoto (rama main de GitHub) con el local y solo ofrece
# actualizar si el remoto es MAS NUEVO. Comprueba como mucho una vez al dia,
# valida la sintaxis antes de instalar y reemplaza el archivo de forma atomica.
UPDATE_URL="https://raw.githubusercontent.com/KabraX/the-wired/main/the-wired"
UPDATE_STAMP="$HISTORY_DIR/.last_update_check"
UPDATE_INTERVAL=86400

check_update() {
    local script_path script_dir remote_file remote_version now last=0

    script_path="$SCRIPT_PATH"
    script_dir=$(dirname "$script_path")

    if [[ "${THE_WIRED_NO_UPDATE:-0}" == "1" ]]; then
        return 0
    fi

    # Instalado como clon de git: se actualiza con git, no reescribiendo el archivo
    if git -C "$script_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        if [[ "${FORCE_UPDATE_CHECK:-0}" == "1" ]]; then
            echo -e "${BLUE}Instalado desde git: actualiza con ${CYAN}git -C \"$script_dir\" pull --ff-only${NC}"
            exit 0
        fi
        return 0
    fi

    mkdir -p "$HISTORY_DIR"
    now=$(date +%s)
    [[ -f "$UPDATE_STAMP" ]] && last=$(cat "$UPDATE_STAMP" 2>/dev/null || echo 0)
    if [[ "${FORCE_UPDATE_CHECK:-0}" != "1" ]] && ((now - last < UPDATE_INTERVAL)); then
        return 0
    fi
    echo "$now" >"$UPDATE_STAMP"

    echo -e "${BLUE}Verificando actualizaciones...${NC}"
    remote_file=$(mktemp) || return 0
    if ! curl -fsSL --connect-timeout 5 --max-time 15 "$UPDATE_URL" -o "$remote_file"; then
        echo -e "${YELLOW}No se pudo comprobar si hay actualizaciones.${NC}"
        rm -f "$remote_file"
        return 0
    fi

    remote_version=$(grep -m1 -oE '^VERSION="[^"]+"' "$remote_file" | cut -d'"' -f2)
    if [[ -z "$remote_version" ]] || ! head -1 "$remote_file" | grep -q '^#!/bin/bash'; then
        echo -e "${YELLOW}La version remota no parece valida; se omite.${NC}"
        rm -f "$remote_file"
        return 0
    fi

    # Solo si el remoto es estrictamente mas nuevo (sort -V entiende 1.10 > 1.9)
    if [[ "$remote_version" == "$VERSION" ]] ||
        [[ "$(printf '%s\n%s\n' "$VERSION" "$remote_version" | sort -V | tail -1)" != "$remote_version" ]]; then
        [[ "${FORCE_UPDATE_CHECK:-0}" == "1" ]] && echo -e "${GREEN}Ya tienes la ultima version (v$VERSION).${NC}"
        rm -f "$remote_file"
        return 0
    fi

    if ! bash -n "$remote_file" 2>/dev/null; then
        echo -e "${RED}La version v$remote_version tiene errores de sintaxis; no se instala.${NC}"
        rm -f "$remote_file"
        return 0
    fi

    echo -n -e "${CYAN}Hay una version nueva: v$VERSION -> v$remote_version. ¿Actualizar? (y/n) ${NC}"
    read -r ele
    if [[ "$ele" != "y" ]]; then
        rm -f "$remote_file"
        return 0
    fi

    chmod 755 "$remote_file"
    if [[ -w "$script_dir" ]]; then
        # mv dentro del mismo sistema de archivos es atomico
        cp "$remote_file" "$script_path.new" && mv -f "$script_path.new" "$script_path"
    else
        sudo install -m 755 "$remote_file" "$script_path"
    fi && echo -e "${GREEN}Actualizado a v$remote_version. Vuelve a ejecutar the-wired.${NC}" ||
        echo -e "${RED}No se pudo instalar la actualizacion.${NC}"

    rm -f "$remote_file"
    exit 0
}

